PAYLOAD_SECRET=replace-with-long-random-secret
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Payload + Postgres
DATABASE_URI=postgres://postgres:postgres@postgres:5432/personal_site

# S3-compatible storage (MinIO in local Docker)
S3_BUCKET=personal-site
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
